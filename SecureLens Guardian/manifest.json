{
  "manifest_version": 3,
  "name": "SecureLens Guardian",
  "version": "1.1.0",
  "description": "Quick domain safety checks, warning interstitials, and local history powered by your SecureLens backend.",
  "permissions": ["storage", "tabs", "activeTab"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SecureLens",
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "114"
}
